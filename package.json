{
  "name": "tree-inventory-app",
  "version": "1.0.0",
  "description": "Tree inventory management application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run watch\" \"npm run electron\"",
    "watch": "webpack --watch --mode development",
    "build": "webpack --mode production",
    "electron": "wait-on http://localhost:8080 && electron .",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "tree",
    "inventory",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.tree-inventory.app",
    "productName": "Tree Inventory",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "database.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to record GPS coordinates for tree inventory data.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to record GPS coordinates for tree inventory data."
      }
    }
  }
}
